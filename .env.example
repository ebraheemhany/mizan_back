NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/mizan?schema=public"
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=1
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
# Comma-separated list of allowed frontend origins
# Frontend base URL, used in invite links
APP_URL=http://localhost:3000
INVITATION_TTL_DAYS=7
# Public URL of this API (company logos in emails load from here)
API_URL=http://localhost:4000

# Email through Resend (https://resend.com, needs a domain of your own) or a Gmail
# account (no domain needed). Leave all of them empty in development: each email is
# then written to MAIL_OUTBOX_DIR as an .html file instead of being sent.
RESEND_API_KEY=
# Resend: must be on a domain verified there (onboarding@resend.dev only reaches your own
# inbox). Gmail: only the name is used.
MAIL_FROM="Mizan <onboarding@resend.dev>"
# Gmail: all four, printed by `npm run gmail:token` (used only when RESEND_API_KEY is empty)
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# "Sign in with Google": the Client ID of a "Web application" OAuth client whose
# Authorized JavaScript origins hold the frontend's address. Not a secret; the frontend
# needs the same value in NEXT_PUBLIC_GOOGLE_CLIENT_ID. Empty: the button is hidden.
GOOGLE_CLIENT_ID=

# Encrypts the Paymob keys companies connect (their customers pay invoices by card).
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production to connect Paymob; changing it makes saved keys unreadable.
# Empty in development: a key derived from JWT_SECRET is used.
ENCRYPTION_KEY=
MAIL_OUTBOX_DIR=.mail-outbox
# The in-app assistant runs on free AI models through any OpenAI-compatible chat API.
# Set one or both; they are tried in this order, and the next one takes over when one
# is out of its free quota or down. With neither set, the assistant is off (its button
# is hidden). Nothing here is a subscription.
# 1. Your own server (Ollama: http://<host>:11434/v1, model e.g. qwen3:14b) or any
#    other provider (OpenRouter: https://openrouter.ai/api/v1 with a model ending :free).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 2. Groq's free plan: a key from console.groq.com (API keys). Free limits are per
#    account and small (about 1,000 requests and 200K tokens a day).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Subscriptions through Paymob (Egypt): Dashboard → Settings → Account info, and
# Developers → Payment integrations. Leave empty in development: checkouts then go
# to a local test page (no money moves). Production refuses payments without them.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# The card integration shown at checkout (saves the card for renewals)
PAYMOB_CARD_INTEGRATION_ID=
# Charges the saved card each month (MOTO; Paymob's support enables it on request)
PAYMOB_MOTO_INTEGRATION_ID=
# Paymob calls <API_URL>/api/public/paymob/webhook (sent with every payment, so
# API_URL must be reachable from the internet).
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=72
CORS_ORIGIN=http://localhost:3000
# Number of proxies in front of the app (1 behind Nginx/Railway/Render). false locally.
TRUST_PROXY=false

# Used only by `npm test`. Must point at a database whose name ends in _test (it gets wiped).
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/mizan_test?schema=public"
