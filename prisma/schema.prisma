generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  accountant
  sales
  viewer
}

model Company {
  id   String @id @default(uuid())
  name String

  // --- Settings (edited by the owner in Settings) ---

  // Company details printed on invoices.
  taxNumber          String?
  commercialRegister String?
  phone              String?
  address            String?

  // Taxes and money.
  currency           Currency @default(EGP)
  vatEnabled         Boolean  @default(true)
  withholdingEnabled Boolean  @default(false)
  fiscalStartMonth   Int      @default(1)

  // Numbering: the next invoice is invoicePrefix + invoiceNextNumber (INV-1044).
  invoicePrefix     String @default("INV-")
  invoiceNextNumber Int    @default(1)
  quotePrefix       String @default("Q-")
  quoteNextNumber   Int    @default(1)
  // Receipts: PAY-0001, PAY-0002...
  paymentNextNumber Int    @default(1)
  paymentTermsDays  Int    @default(30)

  // Invoice look.
  invoiceTemplate InvoiceTemplate @default(classic)
  invoiceFooter   String?

  // On/off switches. JSON so new switches don't need a migration.
  notifications Json @default("{\"overdueInvoice\":true,\"newPayment\":true,\"taskReminder\":true,\"weeklyDigest\":false}")
  integrations  Json @default("{\"whatsapp\":false,\"paymentGateway\":false,\"eta\":false,\"calendar\":false}")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users       User[]
  invitations Invitation[]
  customers   Customer[]
  products    Product[]
  invoices    Invoice[]
  payments    InvoicePayment[]

  @@map("companies")
}

enum Currency {
  EGP
  USD
  SAR
  AED
}

enum InvoiceTemplate {
  classic
  modern
  minimal
}

enum ProductType {
  service
  product
}

enum ProductCategory {
  software
  support
  consulting
  devices
  network
  accessories
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  fullName          String
  passwordHash      String
  role              Role      @default(viewer)
  // Access tokens issued before this moment are rejected (set on password change).
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  refreshTokens     RefreshToken[]
  sentInvitations   Invitation[]
  assignedCustomers Customer[]
  createdInvoices   Invoice[]
  invoicePayments   InvoicePayment[]
  invoiceEvents     InvoiceEvent[]

  @@index([companyId])
  @@map("users")
}

model Customer {
  id          String  @id @default(uuid())
  name        String
  // Optional details: null when left empty.
  contactName String?
  phone       String?
  email       String?
  city        String?
  taxNumber   String?
  notes       String?

  // What the customer owes. Kept up to date by invoices and payments (coming
  // later); 0 until then. Stored, not computed, so lists can sort/filter on it.
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  // Last invoice, payment or edit. Drives "recent" sorting and the inactive status.
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Team member responsible for this customer. Cleared if they leave the team.
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  invoices Invoice[]

  @@index([companyId, lastActivityAt])
  @@index([companyId, name])
  @@index([assignedToId])
  @@map("customers")
}

// An owner invites someone by email with a role. The invite link carries a random
// token; only its SHA-256 hash is stored. Accepting it creates the user.
model Invitation {
  id         String    @id @default(uuid())
  // Stored lowercased, like User.email.
  email      String
  name       String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Kept when the inviter is later removed, so the invite itself survives.
  invitedById String?
  invitedBy   User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

// One row per issued refresh token. Only a SHA-256 hash is stored, never the token.
// Every login starts a "family"; each refresh revokes the used token and adds a
// new one to the same family. Reusing a revoked token revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  familyId   String
  // true when the user logged in with "remember me" (longer lifetime).
  persistent Boolean   @default(false)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Something the company sells: a service or a product (catalog item).
model Product {
  id       String          @id @default(uuid())
  name     String
  type     ProductType
  // Unique per company, stored uppercase (e.g. SRV-001).
  code     String
  price    Decimal         @db.Decimal(14, 2)
  // Percent: 14 means 14%.
  taxRate  Decimal         @db.Decimal(5, 2)
  category ProductCategory

  // Products only (null for services).
  stock      Int?
  lowStockAt Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceLines InvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId, createdAt])
  @@map("products")
}

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  cancelled
}

enum PaymentMethod {
  cash
  // Bank transfer.
  bank
  card
  instapay
  vodafoneCash
  cheque
}

// A cheque stays pending until it clears; everything else is cleared at once.
enum PaymentStatus {
  cleared
  pending
}

// Where the money went in.
enum ReceivingAccount {
  bank
  cashbox
  wallet
}

enum InvoiceEventType {
  created
  sent
  viewed
  reminderSent
  payment
  paymentRemoved
  cancelled
}

// "overdue" is not a stored status: a sent/partial invoice whose due date has
// passed is overdue (worked out when reading, by Africa/Cairo date).
model Invoice {
  id           String        @id @default(uuid())
  // Sequential per company, assigned on creation from the company's invoiceNextNumber.
  number       Int
  // The prefix in force when the invoice was created (INV-), shown as INV-1044.
  numberPrefix String
  status       InvoiceStatus

  issueDate        DateTime @db.Date
  dueDate          DateTime @db.Date
  paymentTermsDays Int

  // Customer details as they were when the invoice was written: an invoice must
  // not change if the customer record is edited later.
  customerName      String
  customerTaxNumber String?
  customerEmail     String?
  customerPhone     String?
  customerCity      String?

  subtotal   Decimal @db.Decimal(14, 2)
  // Percent: 14 means 14%. 0 when VAT is off in the settings.
  vatRate    Decimal @db.Decimal(5, 2)
  vat        Decimal @db.Decimal(14, 2)
  total      Decimal @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @db.Decimal(14, 2)

  notes       String?
  // Random token for the public link (/i/<token>). Set when the invoice is sent.
  publicToken String?   @unique
  sentAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // A customer with invoices can't be deleted (NoAction = refused, checked at the
  // end of the statement, so deleting a whole company still works).
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: NoAction)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lines    InvoiceLine[]
  payments InvoicePayment[]
  events   InvoiceEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  // quantity x unitPrice, rounded to 2 decimals.
  amount      Decimal @db.Decimal(14, 2)

  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Optional link to the catalog; the line keeps its own text and price.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoicePayment {
  id        String            @id @default(uuid())
  // Sequential per company (shown as PAY-0001).
  number    Int
  amount    Decimal           @db.Decimal(14, 2)
  date      DateTime          @db.Date
  method    PaymentMethod
  status    PaymentStatus     @default(cleared)
  account   ReceivingAccount?
  // Transfer or cheque number.
  reference String?
  note      String?
  clearedAt DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([invoiceId])
  @@index([companyId, date])
  @@map("invoice_payments")
}

// The invoice's history timeline (created, sent, payment...).
model InvoiceEvent {
  id        String           @id @default(uuid())
  type      InvoiceEventType
  values    Json             @default("{}")
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_events")
}
