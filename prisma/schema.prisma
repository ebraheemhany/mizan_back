generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  accountant
  sales
  viewer
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users       User[]
  invitations Invitation[]
  customers   Customer[]

  @@map("companies")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  fullName          String
  passwordHash      String
  role              Role      @default(viewer)
  // Access tokens issued before this moment are rejected (set on password change).
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  refreshTokens     RefreshToken[]
  sentInvitations   Invitation[]
  assignedCustomers Customer[]

  @@index([companyId])
  @@map("users")
}

model Customer {
  id          String  @id @default(uuid())
  name        String
  // Optional details: null when left empty.
  contactName String?
  phone       String?
  email       String?
  city        String?
  taxNumber   String?
  notes       String?

  // What the customer owes. Kept up to date by invoices and payments (coming
  // later); 0 until then. Stored, not computed, so lists can sort/filter on it.
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  // Last invoice, payment or edit. Drives "recent" sorting and the inactive status.
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Team member responsible for this customer. Cleared if they leave the team.
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([companyId, lastActivityAt])
  @@index([companyId, name])
  @@index([assignedToId])
  @@map("customers")
}

// An owner invites someone by email with a role. The invite link carries a random
// token; only its SHA-256 hash is stored. Accepting it creates the user.
model Invitation {
  id         String    @id @default(uuid())
  // Stored lowercased, like User.email.
  email      String
  name       String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Kept when the inviter is later removed, so the invite itself survives.
  invitedById String?
  invitedBy   User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

// One row per issued refresh token. Only a SHA-256 hash is stored, never the token.
// Every login starts a "family"; each refresh revokes the used token and adds a
// new one to the same family. Reusing a revoked token revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  familyId   String
  // true when the user logged in with "remember me" (longer lifetime).
  persistent Boolean   @default(false)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
