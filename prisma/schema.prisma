generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  accountant
  sales
  viewer
}

model Company {
  id   String @id @default(uuid())
  name String

  // --- Settings (edited by the owner in Settings) ---

  // Company details printed on invoices.
  taxNumber          String?
  commercialRegister String?
  phone              String?
  address            String?

  // Taxes and money.
  currency           Currency @default(EGP)
  vatEnabled         Boolean  @default(true)
  withholdingEnabled Boolean  @default(false)
  fiscalStartMonth   Int      @default(1)

  // Numbering: the next invoice is invoicePrefix + invoiceNextNumber (INV-1044).
  invoicePrefix     String @default("INV-")
  invoiceNextNumber Int    @default(1)
  quotePrefix       String @default("Q-")
  quoteNextNumber   Int    @default(1)
  // Receipts: PAY-0001, PAY-0002...
  paymentNextNumber Int    @default(1)
  paymentTermsDays  Int    @default(30)

  // Invoice look.
  invoiceTemplate InvoiceTemplate @default(classic)
  invoiceFooter   String?

  // On/off switches. JSON so new switches don't need a migration.
  notifications Json @default("{\"overdueInvoice\":true,\"newPayment\":true,\"taskReminder\":true,\"weeklyDigest\":false}")
  integrations  Json @default("{\"whatsapp\":false,\"paymentGateway\":false,\"eta\":false,\"calendar\":false}")

  // --- Books ---
  // Manual journal entries: JE-0001, JE-0002...
  journalNextNumber  Int       @default(1)
  // Everything dated on or before this day is closed: no entry may be added,
  // changed or removed there (invoices, payments and expenses included).
  booksClosedThrough DateTime? @db.Date
  booksClosedAt      DateTime? @db.Timestamptz(3)

  // The logo printed on invoices and quotes (an uploaded file).
  logoFileId String?     @unique
  logo       StoredFile? @relation("CompanyLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ledgerAccounts LedgerAccount[]
  auditEvents    AuditEvent[]
  deals          Deal[]
  files          StoredFile[]       @relation("CompanyFiles")
  journalEntries JournalEntry[]
  users          User[]
  invitations    Invitation[]
  customers      Customer[]
  products       Product[]
  invoices       Invoice[]
  payments       InvoicePayment[]
  expenses       Expense[]
  tasks          Task[]
  quotes         Quote[]
  recurring      RecurringInvoice[]

  @@map("companies")
}

enum Currency {
  EGP
  USD
  SAR
  AED
}

enum InvoiceTemplate {
  classic
  modern
  minimal
}

enum ProductType {
  service
  product
}

enum ProductCategory {
  software
  support
  consulting
  devices
  network
  accessories
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  fullName          String
  passwordHash      String
  role              Role      @default(viewer)
  // Access tokens issued before this moment are rejected (set on password change).
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  refreshTokens     RefreshToken[]
  sentInvitations   Invitation[]
  assignedCustomers Customer[]
  createdInvoices   Invoice[]
  invoicePayments   InvoicePayment[]
  invoiceEvents     InvoiceEvent[]
  expenses          Expense[]
  createdTasks      Task[]
  createdQuotes     Quote[]
  quoteEvents       QuoteEvent[]
  createdRecurring  RecurringInvoice[]
  journalEntries    JournalEntry[]
  auditEvents       AuditEvent[]
  ownedDeals        Deal[]             @relation("DealOwner")
  uploadedFiles     StoredFile[]
  createdDeals      Deal[]             @relation("DealCreator")

  @@index([companyId])
  @@map("users")
}

model Customer {
  id          String  @id @default(uuid())
  name        String
  // Optional details: null when left empty.
  contactName String?
  phone       String?
  email       String?
  city        String?
  taxNumber   String?
  notes       String?

  // What the customer owes. Kept up to date by invoices and payments (coming
  // later); 0 until then. Stored, not computed, so lists can sort/filter on it.
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  // Last invoice, payment or edit. Drives "recent" sorting and the inactive status.
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Team member responsible for this customer. Cleared if they leave the team.
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  invoices  Invoice[]
  tasks     Task[]
  quotes    Quote[]
  recurring RecurringInvoice[]
  deals     Deal[]

  @@index([companyId, lastActivityAt])
  @@index([companyId, name])
  @@index([assignedToId])
  @@map("customers")
}

// An owner invites someone by email with a role. The invite link carries a random
// token; only its SHA-256 hash is stored. Accepting it creates the user.
model Invitation {
  id         String    @id @default(uuid())
  // Stored lowercased, like User.email.
  email      String
  name       String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Kept when the inviter is later removed, so the invite itself survives.
  invitedById String?
  invitedBy   User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

// One row per issued refresh token. Only a SHA-256 hash is stored, never the token.
// Every login starts a "family"; each refresh revokes the used token and adds a
// new one to the same family. Reusing a revoked token revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  familyId   String
  // true when the user logged in with "remember me" (longer lifetime).
  persistent Boolean   @default(false)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Something the company sells: a service or a product (catalog item).
model Product {
  id       String          @id @default(uuid())
  name     String
  type     ProductType
  // Unique per company, stored uppercase (e.g. SRV-001).
  code     String
  price    Decimal         @db.Decimal(14, 2)
  // Percent: 14 means 14%.
  taxRate  Decimal         @db.Decimal(5, 2)
  category ProductCategory

  // Products only (null for services).
  stock      Int?
  lowStockAt Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceLines   InvoiceLine[]
  quoteLines     QuoteLine[]
  recurringLines RecurringInvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId, createdAt])
  @@map("products")
}

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  cancelled
}

enum PaymentMethod {
  cash
  // Bank transfer.
  bank
  card
  instapay
  vodafoneCash
  cheque
}

// A cheque stays pending until it clears; everything else is cleared at once.
enum PaymentStatus {
  cleared
  pending
  // A cheque the bank returned: its amount is owed again (the payment stays, as history).
  bounced
}

// Where the money went in.
enum ReceivingAccount {
  bank
  cashbox
  wallet
}

enum InvoiceEventType {
  created
  sent
  viewed
  reminderSent
  payment
  paymentRemoved
  chequeBounced
  cancelled
}

// "overdue" is not a stored status: a sent/partial invoice whose due date has
// passed is overdue (worked out when reading, by Africa/Cairo date).
model Invoice {
  id           String        @id @default(uuid())
  // Sequential per company, assigned on creation from the company's invoiceNextNumber.
  number       Int
  // The prefix in force when the invoice was created (INV-), shown as INV-1044.
  numberPrefix String
  status       InvoiceStatus

  issueDate        DateTime @db.Date
  dueDate          DateTime @db.Date
  paymentTermsDays Int

  // Customer details as they were when the invoice was written: an invoice must
  // not change if the customer record is edited later.
  customerName      String
  customerTaxNumber String?
  customerEmail     String?
  customerPhone     String?
  customerCity      String?

  subtotal   Decimal @db.Decimal(14, 2)
  // Percent: 14 means 14%. 0 when VAT is off in the settings.
  vatRate    Decimal @db.Decimal(5, 2)
  vat        Decimal @db.Decimal(14, 2)
  total      Decimal @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @db.Decimal(14, 2)

  notes       String?
  // Random token for the public link (/i/<token>). Set when the invoice is sent.
  publicToken String?   @unique
  sentAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // A customer with invoices can't be deleted (NoAction = refused, checked at the
  // end of the statement, so deleting a whole company still works).
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: NoAction)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lines    InvoiceLine[]
  payments InvoicePayment[]
  events   InvoiceEvent[]
  // The accepted quote this invoice was made from, if any.
  quote    Quote?

  // Made by a recurring template: which one, and for which scheduled date. One
  // invoice per template and date (the unique key makes a repeated run harmless).
  recurringId      String?
  recurring        RecurringInvoice? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  recurringRunDate DateTime?         @db.Date

  @@unique([companyId, number])
  @@unique([recurringId, recurringRunDate])
  @@index([companyId, status])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  // quantity x unitPrice, rounded to 2 decimals.
  amount      Decimal @db.Decimal(14, 2)

  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Optional link to the catalog; the line keeps its own text and price.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoicePayment {
  id        String            @id @default(uuid())
  // Sequential per company (shown as PAY-0001).
  number    Int
  amount    Decimal           @db.Decimal(14, 2)
  date      DateTime          @db.Date
  method    PaymentMethod
  status    PaymentStatus     @default(cleared)
  account   ReceivingAccount?
  // Transfer or cheque number.
  reference String?
  note      String?
  clearedAt DateTime?         @db.Timestamptz(3)
  bouncedAt DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([invoiceId])
  @@index([companyId, date])
  @@map("invoice_payments")
}

// The invoice's history timeline (created, sent, payment...).
model InvoiceEvent {
  id        String           @id @default(uuid())
  type      InvoiceEventType
  values    Json             @default("{}")
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_events")
}

enum ExpenseCategory {
  salaries
  rent
  purchases
  marketing
  utilities
  software
}

// Paid now, or owed to a vendor (due) and paid later.
enum ExpenseStatus {
  paid
  due
}

enum ExpenseSource {
  bank
  cash
  card
}

model Expense {
  id            String          @id @default(uuid())
  title         String
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(14, 2)
  // The day the expense belongs to (it counts in this day's month).
  date          DateTime        @db.Date
  status        ExpenseStatus
  // Where the money came from; set once it is paid.
  paidFrom      ExpenseSource?
  paidAt        DateTime?       @db.Timestamptz(3)
  // The business day it was paid: its own date when saved as paid, the day it was
  // paid on when it was due first (the books move it out of "suppliers" then).
  paidOn        DateTime?       @db.Date
  // A photo or PDF of the receipt (an uploaded file).
  receiptFileId String?         @unique
  receipt       StoredFile?     @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  // When a due expense has to be paid.
  dueDate       DateTime?       @db.Date
  vendor        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, date])
  @@index([companyId, status])
  @@map("expenses")
}

enum TaskPriority {
  urgent
  important
  normal
}

enum TaskKind {
  meeting
  quote
  collection
  visit
  deadline
  admin
}

// A to-do for the team (call a customer, chase a payment, prepare a quote...).
model Task {
  id          String       @id @default(uuid())
  title       String
  dueDate     DateTime     @db.Date
  priority    TaskPriority @default(normal)
  kind        TaskKind     @default(admin)
  // The Cairo business date it was marked done (null while open).
  completedOn DateTime?    @db.Date
  completedAt DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Optional link to a customer; the task stays if the customer is deleted.
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Optional link to a deal (a call, a meeting about it); the task stays if the deal is deleted.
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, dueDate])
  @@index([dealId])
  @@index([companyId, completedOn])
  @@index([customerId])
  @@map("tasks")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
}

enum QuoteEventType {
  created
  sent
  accepted
  rejected
  converted
}

// A price offer (عرض سعر). "expired" is not a stored status: a sent quote whose
// validUntil is before today (Africa/Cairo) is expired, worked out when reading.
model Quote {
  id           String      @id @default(uuid())
  // Sequential per company, assigned on creation from the company's quoteNextNumber.
  number       Int
  // The prefix in force when the quote was created (Q-), shown as Q-212.
  numberPrefix String
  status       QuoteStatus @default(draft)

  issueDate  DateTime @db.Date
  validUntil DateTime @db.Date

  // Customer details as they were when the quote was written (kept if the
  // customer is edited or deleted later).
  customerName      String
  customerTaxNumber String?
  customerEmail     String?
  customerPhone     String?
  customerCity      String?

  subtotal Decimal @db.Decimal(14, 2)
  // Percent: 14 means 14%. 0 when VAT is off in the settings.
  vatRate  Decimal @db.Decimal(5, 2)
  vat      Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  notes       String?
  // Random token for the public link (/q/<token>). Set when the quote is sent.
  publicToken String?   @unique
  sentAt      DateTime? @db.Timestamptz(3)
  // When it was accepted or rejected, and by whom: "customer" (public link) or "user".
  decidedAt   DateTime? @db.Timestamptz(3)
  decidedBy   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cleared if the customer is deleted; the snapshot above keeps the name.
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // The invoice made from this quote (set once, when it is converted).
  convertedInvoiceId String?   @unique
  convertedInvoice   Invoice?  @relation(fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lines  QuoteLine[]
  events QuoteEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(uuid())
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  // quantity x unitPrice, rounded to 2 decimals.
  amount      Decimal @db.Decimal(14, 2)

  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // Optional link to the catalog; the line keeps its own text and price.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_lines")
}

// The quote's history timeline (created, sent, accepted...).
model QuoteEvent {
  id        String         @id @default(uuid())
  type      QuoteEventType
  values    Json           @default("{}")
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  quoteId String
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // null when the customer answered through the public link.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_events")
}

enum RecurringFrequency {
  weekly
  monthly
  quarterly
  yearly
}

enum RecurringStatus {
  active
  paused
  ended
}

enum RecurringEndMode {
  never
  date
  count
}

// A template that makes the same invoice on a schedule (every week, month, quarter or
// year). A job makes each due invoice on its scheduled date.
model RecurringInvoice {
  id        String             @id @default(uuid())
  name      String
  frequency RecurringFrequency
  // The first scheduled date. The k-th date is computed from it (startDate + k steps),
  // so a monthly schedule from the 31st doesn't drift after a short month.
  startDate DateTime           @db.Date
  // Which scheduled date comes next (k), and that date; null once it has ended.
  nextIndex Int                @default(0)
  nextDate  DateTime?          @db.Date
  endMode   RecurringEndMode   @default(never)
  // endMode date: no invoice after this day. endMode count: this many invoices in all.
  endDate   DateTime?          @db.Date
  maxCount  Int?
  status    RecurringStatus    @default(active)

  // Copied onto each invoice.
  paymentTermsDays Int
  autoSend         Boolean
  notes            String?

  // Per invoice, with the VAT setting in force when the template was saved (each
  // invoice is worked out again when it is made).
  subtotal Decimal @db.Decimal(14, 2)
  vatRate  Decimal @db.Decimal(5, 2)
  vat      Decimal @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  generatedCount Int       @default(0)
  lastRunAt      DateTime? @db.Timestamptz(3)
  // Why the last attempt to make an invoice failed (cleared on success).
  lastError      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lines    RecurringInvoiceLine[]
  invoices Invoice[]

  @@index([companyId, status])
  @@index([status, nextDate])
  @@index([customerId])
  @@map("recurring_invoices")
}

model RecurringInvoiceLine {
  id          String  @id @default(uuid())
  position    Int
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  recurringId String
  recurring   RecurringInvoice @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recurringId])
  @@map("recurring_invoice_lines")
}

// ---------------------------------------------------------------------------
// Books: chart of accounts and manual journal entries
//
// Invoices, payments and expenses are not copied into the books: their entries
// are worked out from the documents themselves whenever the books are read
// (src/modules/ledger/ledger.sql.ts), so the two can never disagree. Only the
// entries an accountant writes by hand are stored here.
// ---------------------------------------------------------------------------

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalStatus {
  draft
  posted
}

// One company's chart of accounts. The built-in accounts (key set) are added on
// first use and are where invoices, payments and expenses post; their names come
// from the app's translations. Accounts the company adds itself have a name and
// no key, and are used in manual entries.
model LedgerAccount {
  id        String      @id @default(uuid())
  code      String
  key       String?
  name      String?
  type      AccountType
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines     JournalLine[]

  @@unique([companyId, code])
  @@unique([companyId, key])
  @@map("ledger_accounts")
}

model JournalEntry {
  id        String        @id @default(uuid())
  // Sequential per company, shown as JE-0001.
  number    Int
  date      DateTime      @db.Date
  memo      String
  // A draft doesn't count in any balance until it is posted.
  status    JournalStatus
  postedAt  DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("journal_entries")
}

model JournalLine {
  id       String  @id @default(uuid())
  position Int
  // One of the two is more than 0, the other is 0.
  debit    Decimal @db.Decimal(14, 2)
  credit   Decimal @db.Decimal(14, 2)

  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  // Cascade only so deleting a whole company works (NoAction failed there: the
  // accounts can go before the lines pointing at them). An account used in an
  // entry is never deleted: deleteAccount locks it and checks first.
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Audit log: who did what, when, from where
// ---------------------------------------------------------------------------

// The kind of change, for filtering. The exact event is AuditEvent.event.
enum AuditAction {
  create
  update
  delete
  send
  cancel
  payment
  permissions
  login
  settings
  books
}

// Written in the same transaction as the change it records (so a change that
// rolled back leaves no line). Nothing in the app edits or deletes these.
model AuditEvent {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  action    AuditAction
  // What happened, e.g. invoiceIssued, paymentRemoved (the app's text: AuditLog.events.<event>).
  event     String
  // What it happened to: invoice, customer, expense, user... with its id and a
  // readable reference (INV-1043, the customer's name) as it was at the time.
  itemType  String
  itemId    String?
  itemRef   String?
  // Details for the text: amount, name, role, changed fields...
  values    Json        @default("{}")
  ip        String?
  // Who, as named at the time (kept if the user is removed later). No user = the
  // system (a recurring invoice, ...) or a customer answering from a link.
  userName  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, userId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Deals (the sales pipeline)
// ---------------------------------------------------------------------------

enum DealStage {
  lead
  contacted
  proposal
  negotiation
  won
}

enum DealLossReason {
  price
  competitor
  postponed
  noResponse
  noNeed
  other
}

model Deal {
  id             String          @id @default(uuid())
  title          String
  value          Decimal         @db.Decimal(14, 2)
  // A lost deal keeps the stage it was lost at (for the funnel and reopening).
  stage          DealStage
  // When it is expected to close; for a won deal, the day it was won.
  closeDate      DateTime        @db.Date
  notes          String?
  // Last time someone worked on it (moved it, edited it, logged a follow-up):
  // a deal left alone for days is flagged on the board.
  lastActivityAt DateTime        @default(now()) @db.Timestamptz(3)
  // Waiting for the customer to answer; cleared by the next activity.
  awaitingReply  Boolean         @default(false)
  // A day to follow up on it (shown on the card that day).
  followUpDate   DateTime?       @db.Date
  wonAt          DateTime?       @db.Timestamptz(3)
  // Lost: set together (the day, why, and an optional note).
  lostOn         DateTime?       @db.Date
  lostReason     DealLossReason?
  lostNote       String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // A customer's deals go with the customer.
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // The team member responsible (none = nobody yet).
  ownerId     String?
  owner       User?    @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("DealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([companyId, stage])
  @@index([customerId])
  @@map("deals")
}

// ---------------------------------------------------------------------------
// Uploaded files (the company logo, expense receipts)
//
// Kept in the database so the app runs on any host without a separate file
// store; files are small (logo ≤ 1 MB, receipt ≤ 5 MB). The type is checked
// from the file's first bytes, not from what the browser said.
// ---------------------------------------------------------------------------

enum FileKind {
  logo
  receipt
}

model StoredFile {
  id          String   @id @default(uuid())
  kind        FileKind
  // image/png, image/jpeg, image/webp, or application/pdf (receipts).
  contentType String
  size        Int
  // The name it had on the uploader's device (for downloads).
  name        String?
  data        Bytes
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  companyId   String
  company     Company @relation("CompanyFiles", fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  logoOf    Company? @relation("CompanyLogo")
  receiptOf Expense?

  @@index([companyId])
  @@map("files")
}
